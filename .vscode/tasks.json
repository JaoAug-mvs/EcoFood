{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-ecofood-windows",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "EcoFood.csproj",
        "-f",
        "net10.0-windows10.0.19041.0",
        "-v",
        "minimal"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {}
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run-ecofood-windows",
      "type": "shell",
      "command": "${workspaceFolder}\\run-windows.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "problemMatcher": []
    }
  ]
}
