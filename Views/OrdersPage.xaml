<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EcoFood.Views.OrdersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:EcoFood.Models"
    xmlns:vm="clr-namespace:EcoFood.ViewModels"
    x:DataType="vm:OrdersViewModel"
    Padding="0"
    BackgroundColor="{DynamicResource Background}"
    Shell.NavBarIsVisible="False"
    Title="Reservas">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Label
            Grid.Row="0"
            FontFamily="OpenSansSemibold"
            FontSize="26"
            Text="Minhas reservas"
            TextColor="{DynamicResource TextPrimary}"
            Padding="18,18,18,12" />

        <!-- Tabs: Ativas | Histórico -->
        <Border
            Grid.Row="1"
            Margin="18,0,18,14"
            BackgroundColor="{DynamicResource SurfaceMuted}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 24"
            Padding="4">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="0">
                <Border
                    BackgroundColor="{Binding ActiveChipBackground}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="0">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        Text="Ativas"
                        HorizontalTextAlignment="Center"
                        Padding="0,10"
                        TextColor="{Binding ActiveChipForeground}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwitchToActiveOrdersCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Border
                    Grid.Column="1"
                    BackgroundColor="{Binding HistoryChipBackground}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="0">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        Text="Histórico"
                        HorizontalTextAlignment="Center"
                        Padding="0,10"
                        TextColor="{Binding HistoryChipForeground}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SwitchToHistoryOrdersCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </Grid>
        </Border>

        <!-- Active orders list -->
        <CollectionView
            Grid.Row="2"
            IsVisible="{Binding IsActiveOrdersVisible}"
            ItemsSource="{Binding ActiveOrders}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40" HorizontalOptions="Center" Spacing="16" VerticalOptions="Center">
                    <Image Source="icon_bag.png" WidthRequest="56" HeightRequest="56" HorizontalOptions="Center" Opacity="0.3" />
                    <Label FontFamily="OpenSansSemibold" FontSize="18" HorizontalTextAlignment="Center" Text="Nenhuma reserva ativa" TextColor="{DynamicResource TextPrimary}" />
                    <Label FontSize="14" HorizontalTextAlignment="Center" Text="Suas reservas confirmadas aparecerão aqui." TextColor="{DynamicResource TextSecondary}" LineHeight="1.4" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:Order">
                    <Border
                        Margin="18,0"
                        Padding="14"
                        Background="{DynamicResource Surface}"
                        Stroke="{DynamicResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,3" Radius="10" Opacity="0.07" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewOrderDetailCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="72,*" ColumnSpacing="14">
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" HeightRequest="72" WidthRequest="72" HorizontalOptions="Start" VerticalOptions="Start">
                                <Image Aspect="AspectFill" Source="{Binding ProductImageUrl}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label FontFamily="OpenSansSemibold" FontSize="16" Text="{Binding ProductName}" TextColor="{DynamicResource TextPrimary}" LineBreakMode="TailTruncation"/>
                                <Label FontSize="13" Text="{Binding RestaurantName}" TextColor="{DynamicResource TextSecondary}" />
                                <HorizontalStackLayout Spacing="6">
                                    <Image Source="icon_clock.png" WidthRequest="13" HeightRequest="13" VerticalOptions="Center"/>
                                    <Label FontSize="12" Text="{Binding PickupWindow}" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border
                                        Padding="8,4"
                                        BackgroundColor="{DynamicResource PrimaryLight}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8">
                                        <Label FontFamily="OpenSansSemibold" FontSize="11" Text="Ativa" TextColor="{DynamicResource TextAccent}" />
                                    </Border>
                                    <Label Grid.Column="1" FontSize="11" Text="{Binding BookingCode}" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" Margin="8,0,0,0"/>
                                    <Label Grid.Column="2" FontFamily="OpenSansSemibold" FontSize="14" Text="{Binding Total, StringFormat='R$ {0:F2}'}" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="112" Opacity="0" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- History orders list -->
        <CollectionView
            Grid.Row="2"
            IsVisible="{Binding IsHistoryOrdersVisible}"
            ItemsSource="{Binding HistoryOrders}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="14"
                    Text="Concluídas"
                    TextColor="{DynamicResource TextSecondary}"
                    Padding="18,4,18,8" />
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40" HorizontalOptions="Center" Spacing="16" VerticalOptions="Center">
                    <Label FontFamily="OpenSansSemibold" FontSize="18" HorizontalTextAlignment="Center" Text="Histórico vazio" TextColor="{DynamicResource TextPrimary}" />
                    <Label FontSize="14" HorizontalTextAlignment="Center" Text="Suas reservas concluídas aparecerão aqui." TextColor="{DynamicResource TextSecondary}" LineHeight="1.4" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:Order">
                    <Border
                        Margin="18,0"
                        Padding="14"
                        Background="{DynamicResource Surface}"
                        Stroke="{DynamicResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,3" Radius="10" Opacity="0.07" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewOrderDetailCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="72,*" ColumnSpacing="14">
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" HeightRequest="72" WidthRequest="72" HorizontalOptions="Start" VerticalOptions="Start">
                                <Image Aspect="AspectFill" Source="{Binding ProductImageUrl}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label FontFamily="OpenSansSemibold" FontSize="16" Text="{Binding ProductName}" TextColor="{DynamicResource TextPrimary}" LineBreakMode="TailTruncation"/>
                                <Label FontSize="13" Text="{Binding RestaurantName}" TextColor="{DynamicResource TextSecondary}" />
                                <HorizontalStackLayout Spacing="6">
                                    <Image Source="icon_clock.png" WidthRequest="13" HeightRequest="13" VerticalOptions="Center"/>
                                    <Label FontSize="12" Text="{Binding PickupWindow}" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border
                                        Padding="8,4"
                                        BackgroundColor="{DynamicResource SurfaceMuted}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8">
                                        <Label FontFamily="OpenSansSemibold" FontSize="11" Text="Concluída" TextColor="{DynamicResource TextSecondary}" />
                                    </Border>
                                    <Label Grid.Column="1" FontSize="11" Text="{Binding BookingCode}" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" Margin="8,0,0,0"/>
                                    <Label Grid.Column="2" FontFamily="OpenSansSemibold" FontSize="14" Text="{Binding Total, StringFormat='R$ {0:F2}'}" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="112" Opacity="0" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
