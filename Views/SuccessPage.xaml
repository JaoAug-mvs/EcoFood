<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EcoFood.Views.SuccessPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EcoFood.ViewModels"
    x:DataType="vm:SuccessViewModel"
    Padding="0"
    BackgroundColor="{DynamicResource Background}"
    Shell.NavBarIsVisible="False"
    Title="Reserva realizada">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,40" Spacing="28" VerticalOptions="Center">

            <!-- Checkmark circle -->
            <Border
                WidthRequest="120" HeightRequest="120"
                HorizontalOptions="Center"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 60">
                <Border.Shadow>
                    <Shadow Brush="#2ECC71" Offset="0,8" Radius="20" Opacity="0.4" />
                </Border.Shadow>
                <Label
                    Text="✓"
                    FontFamily="OpenSansSemibold"
                    FontSize="56"
                    TextColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <!-- Texts -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="26"
                    HorizontalTextAlignment="Center"
                    Text="Reserva realizada!"
                    TextColor="{DynamicResource TextPrimary}" />
                <Label
                    FontFamily="OpenSansRegular"
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    LineHeight="1.5"
                    Text="Sua reserva está confirmada."
                    TextColor="{DynamicResource TextSecondary}" />
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="22"
                    HorizontalTextAlignment="Center"
                    Text="{Binding BookingCodeLabel}"
                    TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>

            <!-- Booking card -->
            <Border
                Background="{DynamicResource Surface}"
                Stroke="{DynamicResource Border}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="16">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="14" Opacity="0.07" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="14">
                        <Border HeightRequest="72" WidthRequest="72" StrokeShape="RoundRectangle 12" StrokeThickness="0" Background="{DynamicResource SurfaceMuted}">
                            <Image Aspect="AspectFill" Source="{Binding ThumbUrl}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label FontFamily="OpenSansSemibold" FontSize="15" Text="{Binding ProductNameDisplay}" TextColor="{DynamicResource TextPrimary}" LineBreakMode="TailTruncation"/>
                            <Label FontFamily="OpenSansSemibold" FontSize="18" Text="{Binding TotalFormatted}" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Border}"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="icon_clock.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label FontSize="12" Text="Retire até" TextColor="{DynamicResource TextSecondary}"/>
                            <Label FontFamily="OpenSansSemibold" FontSize="14" Text="{Binding PickupLineDisplay}" TextColor="{DynamicResource TextPrimary}"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Buttons -->
            <VerticalStackLayout Spacing="12" HorizontalOptions="Fill">
                <Button
                    CornerRadius="28"
                    HeightRequest="56"
                    HorizontalOptions="Fill"
                    Text="Ver minhas reservas"
                    TextColor="White"
                    FontSize="17"
                    FontFamily="OpenSansSemibold"
                    Command="{Binding OpenOrdersCommand}" />
                <Button
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource TextSecondary}"
                    FontFamily="OpenSansSemibold"
                    FontSize="15"
                    HeightRequest="44"
                    HorizontalOptions="Fill"
                    Text="Voltar para o início"
                    Command="{Binding OpenHomeCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
