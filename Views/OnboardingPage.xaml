<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EcoFood.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EcoFood.ViewModels"
    x:DataType="vm:OnboardingViewModel"
    BackgroundColor="{DynamicResource Background}"
    Shell.NavBarIsVisible="False"
    Padding="0">

    <Grid RowDefinitions="Auto,*,220">

        <!-- Top bar: logo + Pular -->
        <Grid
            Grid.Row="0"
            Padding="20,20,20,0"
            ColumnDefinitions="Auto,*,Auto">
            <HorizontalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                <Label Text="Eco" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{DynamicResource TextPrimary}"/>
                <Label Text="Food" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{StaticResource Primary}"/>
            </HorizontalStackLayout>
            <Button
                Grid.Column="2"
                Text="Pular"
                FontFamily="OpenSansSemibold"
                FontSize="14"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource TextSecondary}"
                Clicked="OnSkipClicked"
                HorizontalOptions="End"
                VerticalOptions="Center" />
        </Grid>

        <!-- Slides (sem CarouselView — controle manual via IsVisible) -->
        <Grid Grid.Row="1">

            <!-- Slide 1 -->
            <VerticalStackLayout
                IsVisible="{Binding IsSlide0}"
                Spacing="24"
                Padding="28,32,28,0"
                HorizontalOptions="Fill"
                VerticalOptions="Center">
                <Image
                    Source="logo_verde_sem_fundo.png"
                    Aspect="AspectFit"
                    HeightRequest="240"
                    HorizontalOptions="Center" />
                <VerticalStackLayout Spacing="14">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="26"
                        Text="EcoFood"
                        TextColor="{DynamicResource TextPrimary}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"/>
                    <Label
                        FontFamily="OpenSansRegular"
                        FontSize="15"
                        Text="Alimentação saudável e sustentável para seu dia a dia, com menos desperdício e mais sabor."
                        TextColor="{DynamicResource TextSecondary}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        LineHeight="1.5"
                        Margin="8,0"/>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Slide 2 -->
            <VerticalStackLayout
                IsVisible="{Binding IsSlide1}"
                Spacing="24"
                Padding="28,32,28,0"
                HorizontalOptions="Fill"
                VerticalOptions="Center">
                <Image
                    Source="logo_branca_sem_fundo.png"
                    Aspect="AspectFit"
                    HeightRequest="240"
                    HorizontalOptions="Center" />
                <VerticalStackLayout Spacing="14">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="26"
                        Text="Menos desperdício"
                        TextColor="{DynamicResource TextPrimary}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"/>
                    <Label
                        FontFamily="OpenSansRegular"
                        FontSize="15"
                        Text="Encontre pratos preparados com ingredientes selecionados e entregues com responsabilidade ambiental."
                        TextColor="{DynamicResource TextSecondary}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        LineHeight="1.5"
                        Margin="8,0"/>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Slide 3 -->
            <VerticalStackLayout
                IsVisible="{Binding IsSlide2}"
                Spacing="24"
                Padding="28,32,28,0"
                HorizontalOptions="Fill"
                VerticalOptions="Center">
                <Image
                    Source="logo_verde_sem_fundo.png"
                    Aspect="AspectFit"
                    HeightRequest="240"
                    HorizontalOptions="Center" />
                <VerticalStackLayout Spacing="14">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="26"
                        Text="Pedidos rápidos"
                        TextColor="{DynamicResource TextPrimary}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"/>
                    <Label
                        FontFamily="OpenSansRegular"
                        FontSize="15"
                        Text="Reserve, acompanhe e retire com facilidade — uma experiência pensada para o seu tempo."
                        TextColor="{DynamicResource TextSecondary}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        LineHeight="1.5"
                        Margin="8,0"/>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </Grid>

        <!-- Bottom: bolinhas + botão -->
        <VerticalStackLayout Grid.Row="2" Spacing="16" Padding="24,16,24,40">

            <!-- Bolinhas indicadoras manuais -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                <Ellipse WidthRequest="10" HeightRequest="10" Fill="{DynamicResource Border}">
                    <Ellipse.Triggers>
                        <DataTrigger TargetType="Ellipse" Binding="{Binding IsSlide0}" Value="True">
                            <Setter Property="Fill" Value="{StaticResource Primary}" />
                        </DataTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Ellipse WidthRequest="10" HeightRequest="10" Fill="{DynamicResource Border}">
                    <Ellipse.Triggers>
                        <DataTrigger TargetType="Ellipse" Binding="{Binding IsSlide1}" Value="True">
                            <Setter Property="Fill" Value="{StaticResource Primary}" />
                        </DataTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Ellipse WidthRequest="10" HeightRequest="10" Fill="{DynamicResource Border}">
                    <Ellipse.Triggers>
                        <DataTrigger TargetType="Ellipse" Binding="{Binding IsSlide2}" Value="True">
                            <Setter Property="Fill" Value="{StaticResource Primary}" />
                        </DataTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
            </HorizontalStackLayout>

            <Button
                Text="{Binding PrimaryButtonText}"
                Clicked="OnStartClicked"
                CornerRadius="28"
                HeightRequest="56"
                FontFamily="OpenSansSemibold"
                FontSize="17"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
