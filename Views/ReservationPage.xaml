<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EcoFood.Views.ReservationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EcoFood.ViewModels"
    x:DataType="vm:ReservationViewModel"
    Padding="16,16,16,0"
    BackgroundColor="{StaticResource Background}"
    Title="Reservar">

    <Grid RowDefinitions="*,Auto" RowSpacing="0">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20" Padding="0,8,0,16">

                <!-- Step indicator com labels -->
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="0" HorizontalOptions="Center">
                    <!-- Step 1 (active) -->
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                        <Border
                            WidthRequest="36" HeightRequest="36"
                            Background="{StaticResource Primary}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            HorizontalOptions="Center">
                            <Label Text="1" TextColor="White" FontFamily="OpenSansSemibold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Reserva" FontSize="11" TextColor="{StaticResource Primary}" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                    <!-- Line -->
                    <BoxView Grid.Column="1" HeightRequest="2" BackgroundColor="{StaticResource Border}" VerticalOptions="Start" Margin="4,17,4,0" WidthRequest="60"/>
                    <!-- Step 2 -->
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="6">
                        <Border
                            WidthRequest="36" HeightRequest="36"
                            Background="{StaticResource Surface}"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            HorizontalOptions="Center">
                            <Label Text="2" TextColor="{StaticResource TextSecondary}" FontFamily="OpenSansSemibold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Confirmação" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                    <!-- Line -->
                    <BoxView Grid.Column="3" HeightRequest="2" BackgroundColor="{StaticResource Border}" VerticalOptions="Start" Margin="4,17,4,0" WidthRequest="60"/>
                    <!-- Step 3 -->
                    <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="6">
                        <Border
                            WidthRequest="36" HeightRequest="36"
                            Background="{StaticResource Surface}"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            HorizontalOptions="Center">
                            <Label Text="3" TextColor="{StaticResource TextSecondary}" FontFamily="OpenSansSemibold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Pronto" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Retirada -->
                <Border Stroke="{StaticResource Border}" StrokeThickness="1" Background="{StaticResource Surface}" StrokeShape="RoundRectangle 20" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label FontFamily="OpenSansSemibold" FontSize="13" Text="Retirada" TextColor="{StaticResource TextSecondary}"/>
                        <HorizontalStackLayout Spacing="12">
                            <Image Source="icon_location.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                            <VerticalStackLayout Spacing="2">
                                <Label FontFamily="OpenSansSemibold" FontSize="15" Text="{Binding SummaryRestaurant}" TextColor="{StaticResource TextPrimary}"/>
                                <Label FontSize="13" Text="{Binding AddressLine}" TextColor="{StaticResource TextSecondary}"/>
                                <Label FontSize="12" Text="{Binding DistanceLine}" TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Horário de retirada -->
                <Border Stroke="{StaticResource Border}" StrokeThickness="1" Background="{StaticResource Surface}" StrokeShape="RoundRectangle 20" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label FontFamily="OpenSansSemibold" FontSize="13" Text="Até quando posso retirar?" TextColor="{StaticResource TextSecondary}"/>
                        <HorizontalStackLayout Spacing="10">
                            <Image Source="icon_clock.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                            <Label FontFamily="OpenSansSemibold" FontSize="15" Text="{Binding PickupLine}" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Itens -->
                <Border Stroke="{StaticResource Border}" StrokeThickness="1" Background="{StaticResource Surface}" StrokeShape="RoundRectangle 20" Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Label FontFamily="OpenSansSemibold" FontSize="13" Text="Itens" TextColor="{StaticResource TextSecondary}"/>
                        <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="14">
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" HeightRequest="64" WidthRequest="64" Background="{StaticResource SurfaceMuted}">
                                <Image Aspect="AspectFill" Source="{Binding ThumbnailUrl}"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label FontFamily="OpenSansSemibold" FontSize="15" Text="{Binding SummaryTitle}" TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation"/>
                                <Label FontSize="13" Text="{Binding SummaryRestaurant}" TextColor="{StaticResource TextSecondary}"/>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label FontFamily="OpenSansSemibold" FontSize="13" Text="Qtd:" TextColor="{StaticResource TextSecondary}"/>
                                    <Button Command="{Binding DecreaseQtyCommand}" CornerRadius="14" HeightRequest="28" WidthRequest="28"
                                            Text="−" BackgroundColor="{StaticResource SurfaceMuted}" TextColor="{StaticResource TextPrimary}" FontSize="16" Padding="0"/>
                                    <Label FontFamily="OpenSansSemibold" FontSize="15" Text="{Binding Quantity}" VerticalOptions="Center" WidthRequest="24" HorizontalTextAlignment="Center" TextColor="{StaticResource TextPrimary}"/>
                                    <Button Command="{Binding IncreaseQtyCommand}" CornerRadius="14" HeightRequest="28" WidthRequest="28"
                                            Text="+" BackgroundColor="{StaticResource SurfaceMuted}" TextColor="{StaticResource TextPrimary}" FontSize="16" Padding="0"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" FontFamily="OpenSansSemibold" FontSize="15" Text="{Binding TotalFormatted}" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}"/>

                        <!-- Pagamento -->
                        <HorizontalStackLayout Spacing="10">
                            <Image Source="icon_payment.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                            <Label FontSize="13" Text="{Binding PaymentSimpleLabel}" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}"/>

                        <!-- Subtotal + Total -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label FontSize="14" Text="Subtotal" TextColor="{StaticResource TextSecondary}"/>
                            <Label Grid.Column="1" FontSize="14" Text="{Binding TotalFormatted}" TextColor="{StaticResource TextSecondary}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label FontFamily="OpenSansSemibold" FontSize="16" Text="Total" TextColor="{StaticResource TextPrimary}"/>
                            <Label Grid.Column="1" FontFamily="OpenSansSemibold" FontSize="18" Text="{Binding TotalFormatted}" TextColor="{StaticResource Primary}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- CTA fixo -->
        <Grid Grid.Row="1" Padding="0,12,0,28" BackgroundColor="{StaticResource Background}">
            <Button
                CornerRadius="28"
                HeightRequest="56"
                HorizontalOptions="Fill"
                Text="Continuar"
                TextColor="White"
                FontSize="17"
                FontFamily="OpenSansSemibold"
                Command="{Binding ContinueReservationCommand}" />
        </Grid>
    </Grid>
</ContentPage>
