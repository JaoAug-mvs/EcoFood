<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EcoFood.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Background}">

    <Grid>
        <!-- Conteúdo central -->
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20" Padding="32,0">
            <Image Source="logo_verde_sem_fundo.png" WidthRequest="120" HeightRequest="120" Aspect="AspectFit" HorizontalOptions="Center"/>
            <HorizontalStackLayout Spacing="0" HorizontalOptions="Center">
                <Label Text="Eco" FontSize="42" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextPrimary}" />
                <Label Text="Food" FontSize="42" FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}" />
            </HorizontalStackLayout>
            <Label
                Text="Menos desperdício,&#10;mais oportunidades."
                FontSize="16"
                TextColor="{DynamicResource TextSecondary}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                LineHeight="1.5"/>
        </VerticalStackLayout>

        <!-- Botões ancorados no rodapé -->
        <VerticalStackLayout x:Name="BottomSection" VerticalOptions="End" Padding="24,0,24,48" Spacing="12">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,0,0,12">
                <BoxView Color="{StaticResource Primary}" WidthRequest="28" HeightRequest="8" CornerRadius="4"/>
                <BoxView Color="{DynamicResource Gray200}" WidthRequest="8" HeightRequest="8" CornerRadius="4"/>
                <BoxView Color="{DynamicResource Gray200}" WidthRequest="8" HeightRequest="8" CornerRadius="4"/>
            </HorizontalStackLayout>
            <Button
                Text="Começar"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                CornerRadius="28"
                HeightRequest="56"
                FontFamily="OpenSansSemibold"
                FontSize="17"
                Clicked="OnStartOnboardingClicked" />
            <Button
                Text="Entrar"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource TextSecondary}"
                FontFamily="OpenSansSemibold"
                FontSize="15"
                HeightRequest="44"
                Clicked="OnLoginClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
