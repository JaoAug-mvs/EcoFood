<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EcoFood.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:EcoFood.Models"
    xmlns:vms="clr-namespace:EcoFood.ViewModels"
    x:DataType="vms:HomeViewModel"
    Padding="0"
    BackgroundColor="{DynamicResource Background}"
    Shell.NavBarIsVisible="False"
    Title="EcoFood">

    <CollectionView
        ItemsSource="{Binding VisibleProducts}"
        SelectionMode="None"
        VerticalScrollBarVisibility="Never">

        <CollectionView.ItemsLayout>
            <LinearItemsLayout ItemSpacing="14" Orientation="Vertical" />
        </CollectionView.ItemsLayout>

        <CollectionView.Header>
            <VerticalStackLayout Padding="18,18,18,12" Spacing="16">

                <!-- Bell -->
                <Border
                    HorizontalOptions="End"
                    WidthRequest="42" HeightRequest="42"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 21"
                    BackgroundColor="{DynamicResource Surface}">
                    <ImageButton
                        Style="{x:Null}"
                        Command="{Binding OpenNotificationsCommand}"
                        BackgroundColor="Transparent"
                        WidthRequest="42" HeightRequest="42"
                        Padding="11"
                        Source="icon_alert.png"/>
                </Border>

                <!-- Greeting -->
                <VerticalStackLayout Spacing="2">
                    <Label FontFamily="OpenSansSemibold" FontSize="26" Text="{Binding Greeting}" TextColor="{DynamicResource TextPrimary}" />
                    <Label FontFamily="OpenSansRegular" FontSize="14" Text="{Binding FriendlySubtitle}" TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- Search bar (sem filtro) -->
                <Border
                    Stroke="{DynamicResource Border}"
                    StrokeThickness="1"
                    BackgroundColor="{DynamicResource Surface}"
                    StrokeShape="RoundRectangle 28"
                    HeightRequest="52">
                    <Grid ColumnDefinitions="*,Auto" Padding="16,0" VerticalOptions="Center">
                        <Entry
                            Grid.Column="0"
                            Placeholder="Buscar estabelecimentos ou pratos..."
                            PlaceholderColor="{DynamicResource TextSecondary}"
                            Text="{Binding SearchQuery}"
                            VerticalOptions="Center"
                            TextColor="{DynamicResource TextPrimary}"
                            FontSize="14"
                            HeightRequest="44" />
                        <Image
                            Grid.Column="1"
                            Source="icon_search.png"
                            WidthRequest="20" HeightRequest="20"
                            VerticalOptions="Center"
                            Opacity="0.5"/>
                    </Grid>
                </Border>

                <!-- Categorias com ícone + label (sem card externo) -->
                <CollectionView ItemsSource="{Binding Categories}" HeightRequest="80" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="4" Orientation="Horizontal" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:CategoryChip">
                            <VerticalStackLayout
                                WidthRequest="68"
                                Spacing="6"
                                HorizontalOptions="Center"
                                Padding="4,4">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCategoryCommand}"
                                        CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <!-- Container do ícone -->
                                <Border
                                    WidthRequest="44" HeightRequest="44"
                                    HorizontalOptions="Center"
                                    BackgroundColor="{DynamicResource PrimaryLight}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Image
                                        Source="{Binding Icon}"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        Aspect="AspectFit"/>
                                </Border>
                                <!-- Label da categoria -->
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="11"
                                    Text="{Binding Title}"
                                    TextColor="{DynamicResource TextSecondary}"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Section header -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label FontFamily="OpenSansSemibold" FontSize="18" Text="Ofertas próximas de você" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                    <Label Grid.Column="1" FontFamily="OpenSansSemibold" FontSize="13" Text="Ver todas" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                </Grid>
            </VerticalStackLayout>
        </CollectionView.Header>

        <!-- Cards verticais grandes -->
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vms:ProductListItemVm">
                <Border Margin="18,0" Background="{DynamicResource Surface}" Stroke="{DynamicResource Border}" StrokeThickness="1" StrokeShape="RoundRectangle 20">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.07" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ProductDetailsCommand}"
                            CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="0">
                        <!-- Imagem + badge desconto -->
                        <Grid HeightRequest="175">
                            <Border HorizontalOptions="Fill" StrokeShape="RoundRectangle 20,20,0,0" StrokeThickness="0" VerticalOptions="Fill">
                                <Image Aspect="AspectFill" Source="{Binding Product.ImageUrl}" />
                            </Border>
                            <Border
                                Margin="12"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                Padding="10,5"
                                Background="{StaticResource ErrorBadge}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                                <Label FontFamily="OpenSansSemibold" FontSize="13" Text="{Binding BadgeDiscount}" TextColor="White" />
                            </Border>
                        </Grid>

                        <!-- Info -->
                        <VerticalStackLayout Padding="16,12,16,14" Spacing="5">
                            <Label FontFamily="OpenSansSemibold" FontSize="17" Text="{Binding Product.Name}" TextColor="{DynamicResource TextPrimary}" LineBreakMode="TailTruncation" />
                            <Label FontSize="13" Text="{Binding Product.RestaurantName}" TextColor="{DynamicResource TextSecondary}" />

                            <!-- Rating + distância -->
                            <HorizontalStackLayout Spacing="4" Margin="0,2,0,0">
                                <Label FontSize="13" Text="⭐" VerticalOptions="Center"/>
                                <Label FontFamily="OpenSansSemibold" FontSize="13" Text="{Binding RatingFormatted}" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                                <Label FontSize="13" Text="·" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" Margin="2,0"/>
                                <Label FontSize="13" Text="📍" VerticalOptions="Center"/>
                                <Label FontSize="13" Text="{Binding DistanceFormatted}" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- Preço + retirada -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="End">
                                    <VerticalStackLayout Spacing="1">
                                        <Label FontSize="12" Text="{Binding OldPriceLabel}" TextColor="{DynamicResource TextSecondary}" TextDecorations="Strikethrough"/>
                                        <Label FontFamily="OpenSansSemibold" FontSize="21" Text="{Binding NewPriceLabel}" TextColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" FontFamily="OpenSansSemibold" FontSize="13" Text="{Binding PickupUntilFormatted}" TextColor="{StaticResource Primary}" VerticalOptions="End" HorizontalTextAlignment="End"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="112" Opacity="0" />
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
